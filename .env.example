# SAM3 Labeling Tool Configuration

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/labeling_tool.db

# Device settings (cuda or cpu)
DEVICE=cuda

# SAM3 Model settings
# Option 1: Local SAM3 path (for offline/secure environments)
# Set this to your local SAM3 model directory
SAM3_LOCAL_PATH=/path/to/your/local/sam3
# Optional: specific checkpoint file path
# SAM3_CHECKPOINT=/path/to/checkpoint.pt

# Option 2: HuggingFace settings (for downloading SAM3 model online)
# Only used if SAM3_LOCAL_PATH is not set
HF_TOKEN=your_huggingface_token_here
HF_MODEL_ID=facebook/sam3

# Training settings
DEFAULT_BATCH_SIZE=4
DEFAULT_LEARNING_RATE=0.00001
DEFAULT_NUM_EPOCHS=10
