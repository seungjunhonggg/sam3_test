# SAM3 Labeling Tool Configuration

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/labeling_tool.db

# Device settings (cuda or cpu)
DEVICE=cuda

# HuggingFace settings (for downloading SAM3 model)
HF_TOKEN=your_huggingface_token_here
HF_MODEL_ID=facebook/sam3

# Training settings
DEFAULT_BATCH_SIZE=4
DEFAULT_LEARNING_RATE=0.00001
DEFAULT_NUM_EPOCHS=10
